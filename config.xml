<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset name="discovery" label="COM_FGEXTENSIONMANAGER_CONFIG_DISCOVERY_FIELDSET_LABEL" description="COM_FGEXTENSIONMANAGER_CONFIG_DISCOVERY_FIELDSET_DESC">
		<field
			name="discover_owner"
			type="text"
			label="COM_FGEXTENSIONMANAGER_FIELD_DISCOVER_OWNER_LABEL"
			description="COM_FGEXTENSIONMANAGER_FIELD_DISCOVER_OWNER_DESC"
			hint="napr. FGcodework"
			default="FGcodework"
		/>
		<field
			name="discover_topic"
			type="text"
			label="COM_FGEXTENSIONMANAGER_FIELD_DISCOVER_TOPIC_LABEL"
			description="COM_FGEXTENSIONMANAGER_FIELD_DISCOVER_TOPIC_DESC"
			hint="napr. fg-joomla-extension"
			default="fg-joomla-extension"
		/>
	</fieldset>

	<fieldset name="component" label="COM_FGEXTENSIONMANAGER_CONFIG_FIELDSET_LABEL">
		<field
			name="cache_minutes"
			type="number"
			label="COM_FGEXTENSIONMANAGER_FIELD_CACHE_MINUTES_LABEL"
			description="COM_FGEXTENSIONMANAGER_FIELD_CACHE_MINUTES_DESC"
			default="30"
			min="0"
			max="1440"
		/>
		<field
			name="http_timeout"
			type="number"
			label="COM_FGEXTENSIONMANAGER_FIELD_HTTP_TIMEOUT_LABEL"
			description="COM_FGEXTENSIONMANAGER_FIELD_HTTP_TIMEOUT_DESC"
			default="10"
			min="1"
			max="60"
		/>
	</fieldset>

	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			validate="rules"
			filter="rules"
			component="com_fgextensionmanager"
			section="component"
		/>
	</fieldset>
</config>
